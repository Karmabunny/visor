{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "karmabunny/visor",
    "description": "A supervisor for PHP-CLI servers",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "karmabunny\\visor\\": "src/",
            "karmabunny\\visor\\echo\\": "src/compat/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon",
        "test": "phpunit --testdox --configuration phpunit.xml"
    },
    "config": {
        "platform": {
            "php": "7.4"
        }
    },
    "require": {
        "karmabunny/interfaces": "^1|^2",
        "nyholm/psr7": "^1.8",
        "karmabunny/router": "^2|^3",
        "php": "^7.2|^8"
    }
}
